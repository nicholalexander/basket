# Type signatures for Basket::BackendAdapter
module Basket
  class BackendAdapter
    # Get all data
    def data: () -> Hash[String, Array[untyped]]

    # Push data to a queue
    # Returns Integer (Redis) or Array[Element] (Memory)
    def push: (String queue, Element data) -> (Integer | Array[Element])

    # Get queue length
    def length: (String queue) -> Integer

    # Read all items from a queue
    def read: (String queue) -> Array[untyped]

    # Clear a queue
    # Returns Integer (Redis) or Array (Memory)
    def clear: (String queue) -> (Integer | Array[untyped])

    # Search a queue with a block
    def search: (String queue) { (untyped) -> bool } -> Array[untyped]

    # Remove an element by ID
    def remove: (String queue, String id) -> untyped
  end
end
